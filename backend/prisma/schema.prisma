generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  balance   Float    @default(0)
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  creditCards CreditCard[] @relation("UserCards")
  sentTransactions     Transaction[] @relation("SentTransactions")
  receivedTransactions Transaction[] @relation("ReceivedTransactions")

  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")
  friendshipsA           Friendship[]    @relation("FriendshipsA")
  friendshipsB           Friendship[]    @relation("FriendshipsB")
}

enum Role {
  USER
  ADMIN
}

model ValidCard {
  id         Int     @id @default(autoincrement())
  cardNumber String  @unique
  cvv        String
  expMonth   Int
  expYear    Int
  balance    Float   @default(50000)
}

model CreditCard {
  id         Int      @id @default(autoincrement())
  cardNumber String
  cvv        String
  expMonth   Int
  expYear    Int
  userId     Int
  createdAt  DateTime @default(now())

  user       User     @relation("UserCards", fields: [userId], references: [id])
}

model BlacklistedToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model Transaction {
  id         Int             @id @default(autoincrement())
  sender     User?           @relation("SentTransactions", fields: [senderId], references: [id])
  senderId   Int?
  receiver   User            @relation("ReceivedTransactions", fields: [receiverId], references: [id])
  receiverId Int
  amount     Float
  type       TransactionType
  createdAt  DateTime        @default(now())
}

enum TransactionType {
  TRANSFER
  TOPUP
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELED
}

model FriendRequest {
  id        Int                   @id @default(autoincrement())
  from      User                  @relation("SentFriendRequests", fields: [fromId], references: [id])
  fromId    Int
  to        User                  @relation("ReceivedFriendRequests", fields: [toId], references: [id])
  toId      Int
  status    FriendRequestStatus   @default(PENDING)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([toId])
  @@index([fromId])
}

model Friendship {
  id        Int      @id @default(autoincrement())
  userA     User     @relation("FriendshipsA", fields: [userAId], references: [id])
  userAId   Int
  userB     User     @relation("FriendshipsB", fields: [userBId], references: [id])
  userBId   Int
  createdAt DateTime @default(now())

  @@unique([userAId, userBId], map: "uniq_friend_pair")
  @@index([userAId])
  @@index([userBId])
}